{
  "name": "flight-booking-agent",
  "version": "0.1.0",
  "private": true,
  "description": "FlightGenie searches live flights and enforces booking permission in code. All bookings are simulated. Built with the Claude Agent SDK and Duffel.",
  "type": "module",
  "scripts": {
    "phase0": "tsx src/phase0-hello-world.ts",
    "phase1": "tsx src/phase1-search-flights.ts",
    "phase2": "tsx src/phase2-rank-flights.ts",
    "phase3:hitl": "tsx src/phase3-two-modes.ts --mode=hitl",
    "phase3:auto": "tsx src/phase3-two-modes.ts --mode=automated",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "npm run dev --prefix web",
    "dev": "concurrently -n server,web -c blue,magenta \"npm run dev:server\" \"npm run dev:web\"",
    "build:web": "npm run build --prefix web",
    "phase4": "npm run build:web && PHASE4_SERVE_SPA=1 tsx src/server/index.ts",
    "test": "tsx src/lib/rank-offers.test.ts && tsx src/lib/book-flight.test.ts && tsx src/lib/oversight.test.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "prd-lint": "node tools/prd-lint.mjs",
    "test:tools": "node tools/prd-lint.test.mjs",
    "commit": "node tools/auto-commit.mjs",
    "commit:watch": "node tools/auto-commit.mjs --watch"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.201",
    "@duffel/api": "^4.28.0",
    "dotenv": "^16.4.0",
    "express": "^5.2.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "concurrently": "^10.0.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
