# Copy this file to .env and set your credentials there. Never commit .env.

# Required for the Claude Agent SDK loop, including runs with offline offers.
ANTHROPIC_API_KEY=

# Required for live flight search. The search tool uses this production token.
# Booking is simulated and never calls Duffel's order endpoint.
DUFFEL_API_KEY_PROD=

# Optional for local checks of the Duffel integration.
# The agent's search tool does not use this token.
DUFFEL_API_KEY_TEST=
