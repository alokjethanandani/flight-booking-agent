# Copy to .env and fill in. Never commit .env.

# Required from Phase 0 on — powers the Claude Agent SDK loop.
ANTHROPIC_API_KEY=

# Not needed until Phase 1 (real Duffel search). Search only — `book_flight`
# is mocked end-to-end; no code path may call Duffel's paid `order` endpoint
# in either environment below. See CLAUDE.md guardrails.
#
# PROD is what the actual search_flights tool uses at runtime (locked PRD
# §9/§10 decision — production returns real multi-airline data; test mode
# returns only one sandbox airline, which defeats comparison-shopping).
DUFFEL_API_KEY_PROD=

# TEST is only for local dev/smoke-testing the Duffel wiring (parsing,
# normalization) without spending production quota. Never used by the
# search_flights tool the agent actually calls.
DUFFEL_API_KEY_TEST=
